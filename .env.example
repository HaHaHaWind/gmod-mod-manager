# ============================================================
# GMod Workshop Mod 管理面板 - 环境配置示例
# 用法:复制为 .env 放在 backend/ 目录下(pydantic-settings 自动读取)
#   cp .env.example backend/.env && vim backend/.env
# 所有路径均为 Linux 服务器路径;路径全部可配置,留空表示未配置。
# ============================================================

# ---- 游戏服务器路径(默认值来自部署环境,按需修改) ----
# GMod 专用服务器根目录
GMOD_SERVER_ROOT=/home/l4d2/Steam/steamapps/common/GarrysModDS
# Workshop 缓存目录(srcds 下载的 .gma 落地位置)
WORKSHOP_CACHE_ROOT=/home/l4d2/Steam/steamapps/common/GarrysModDS/steam_cache/content/4000
# garrysmod/addons 目录(local_managed 模式的部署目标)
GMOD_ADDONS_ROOT=/home/l4d2/Steam/steamapps/common/GarrysModDS/garrysmod/addons
# 原生 Workshop ID 清单文件(native_ids 模式的写入目标)
WORKSHOP_IDS_FILE=/home/l4d2/Steam/steamapps/common/GarrysModDS/garrysmod/cfg/srcds_workshop_ids.txt
# 回收站目录(建议放在与 addons 同一文件系统,保证移动为原子操作;必须显式配置)
TRASH_ROOT=/home/l4d2/Steam/steamapps/common/GarrysModDS/.gmm_trash
# 回收站保留天数,超过后由后台自动永久删除
TRASH_RETENTION_DAYS=30

# ---- 面板自身 ----
# 数据目录(数据库/会话/密钥/回收站数据库),相对于 backend 工作目录
DATA_DIR=data
# 后端监听地址与端口(生产由 nginx 反代,仅监听本机)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# 面板对外访问地址(Cookie Secure 判断、审计展示)
PUBLIC_ORIGIN=http://localhost:8080
# 开发模式跨域来源(生产留空)
CORS_DEV_ORIGINS=
# 会话签名密钥:留空则首次启动自动生成并持久化到数据目录
SECRET_KEY=
# 会话有效期(小时)与登录限速(次数/秒)
SESSION_TTL_HOURS=72
LOGIN_RATE_LIMIT=5/300
LOG_LEVEL=INFO
# 运行日志目录(独立于数据目录便于排查):app.log 按大小轮转,单文件 10MB 保留 5 份
# 相对路径基于 backend 工作目录;留空则不写文件日志
LOG_DIR=logs

# ---- 管理模式(核心开关) ----
# observe=只读观察(默认,最安全) / native_ids=写 srcds_workshop_ids.txt / local_managed=部署副本到 addons
MANAGEMENT_MODE=observe
# 服务器控制方式:manual=面板绝不触碰进程 / systemd=仅 systemctl restart(仍不自动重启)
SERVER_CONTROL_MODE=manual
# systemd 模式下的服务单元名(SERVER_CONTROL_MODE=systemd 时必填)
GMOD_SYSTEMD_UNIT=gmodserver.service
# 进程名探测列表(逗号分隔,仅用于展示)
GMOD_PROCESS_NAMES=srcds_linux,srcds_run,srcds.exe
# local_managed 部署策略:gma_copy=复制 .gma / folder_extract=解包为文件夹
LOCAL_MANAGED_STRATEGY=gma_copy
# 只读开关:true=所有写操作被拒绝(首次部署建议先 true 观察一轮)
READ_ONLY=true

# ---- 运行时探针(runtime_state 推断依据) ----
# srcds 运行时会自动把当前挂载的 Workshop ID 写入缓存文件:
#   旧位置:garrysmod/cfg/srcds_addons.txt(注意这是 srcds 生成的缓存,不是配置文件)
#   新位置:<srcds 根>/cache/srcds_addon_list_cache.txt
# 探针可读时,清单内 ID 显示"已加载",其余"未加载";探针缺失时一律显示"未知",不会臆测。
RUNTIME_PROBE_ENABLED=true
# 探针文件路径;留空按上面顺序自动发现(一般无需填写)
RUNTIME_PROBE_FILE=

# ---- Steam ----
STEAM_API_BASE=https://api.steampowered.com
STEAM_BATCH_LIMIT=100
STEAM_TIMEOUT_SECONDS=15
STEAM_RETRIES=2
# 访问 Steam API 与封面 CDN 的 HTTP 代理(国内服务器直连常超时,建议配置)
# 示例:STEAM_PROXY=http://127.0.0.1:7890 ;留空直连;也会读取系统环境变量 HTTP_PROXY/HTTPS_PROXY
STEAM_PROXY=
# 元数据缓存时间(秒),默认 24h
METADATA_TTL_SECONDS=86400
# 可选:Steam Web API Key(用于作者昵称增强查询;不填不影响核心功能)
STEAM_WEB_API_KEY=
# 已知外部集合 ID(用于冲突识别:这些集合引入的 Mod 会被标记)
WORKSHOP_COLLECTION_ID=
# 扫描/元数据刷新后自动抓取创意工坊封面到本地(data/previews),列表优先显示本地图
AUTO_FETCH_PREVIEWS=true

# ---- 保护与限制 ----
# 受保护 Workshop ID(逗号分隔):禁止 delete/以及误操作,如核心地图
PROTECTED_IDS=
# 单个计划最大条目数
MAX_ACTION_IDS=200
# 计划未提交过期时间(分钟)
PLAN_TTL_MINUTES=120
# 预览图代理单次最大字节数
PREVIEW_MAX_BYTES=8388608
